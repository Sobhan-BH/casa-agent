[TEMPLATE]
# CASA configuration (copy to .env)
CASA_ENV=development
CASA_DATABASE_URL=sqlite+aiosqlite:///./casa.db
# Postgres for docker-compose:
# CASA_DATABASE_URL=postgresql+psycopg://casa:casa@db:5432/casa
CASA_REDIS_URL=redis://localhost:6379/0
CASA_LLM_PROVIDER=heuristic
# OpenAI-compatible example:
# CASA_LLM_PROVIDER=openai
# CASA_LLM_API_KEY=sk-...
# CASA_LLM_MODEL=gpt-4o-mini
# CASA_LLM_BASE_URL=https://api.openai.com/v1
CASA_LLM_TIMEOUT_SECONDS=45
CASA_API_HOST=0.0.0.0
CASA_API_PORT=8000
CASA_LOG_LEVEL=INFO
CASA_AUDIT_LOG_PATH=./data/audit.log
CASA_REQUIRE_SIGNED_AUTHORIZATIONS=false
CASA_SIGNING_KEY_PATH=./data/signing_key.pem

# --- v0.2.0 additions -----------------------------------------------------
# API security (empty key = auth disabled; 0 = rate limit disabled)
# CASA_API_KEY=change-me
# CASA_RATE_LIMIT_RPM=120

# Webhook notifications (Slack/Discord/any HTTP endpoint)
# CASA_WEBHOOK_URL=https://hooks.slack.com/services/...
# CASA_WEBHOOK_FORMAT=slack
# CASA_WEBHOOK_EVENTS=JOB_COMPLETED,JOB_FAILED,JOB_BLOCKED

# Continuous monitoring: re-assess targets older than N hours (0 = off)
# CASA_REASSESS_INTERVAL_HOURS=168

# CVE enrichment via OSV.dev (free, no key). Disable for fully offline runs.
# CASA_OSV_ENABLED=true
